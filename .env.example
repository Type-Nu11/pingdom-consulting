# API 서버 주소. 로컬 개발에서는 Vite proxy가 /api 요청을 이 주소로 전달합니다.
VITE_API_BASE_URL=https://www.typenull.xyz

# VITE_API_BASE_URL보다 우선 적용할 프록시 대상이 필요할 때만 설정합니다.
# VITE_PROXY_TARGET=http://localhost:8080

# NAVER Cloud Maps Client ID입니다. Dynamic Map, Geocoding, Reverse Geocoding을 활성화하세요.
# 실행 도메인을 등록하고 Client Secret은 VITE_* 변수에 넣지 않습니다.
VITE_NAVER_MAP_CLIENT_ID=your_naver_maps_client_id
