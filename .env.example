# API 서버 주소. 로컬 개발에서는 Vite proxy가 /api 요청을 이 주소로 전달합니다.
VITE_API_BASE_URL=http://localhost:8080

# VITE_API_BASE_URL보다 우선 적용할 프록시 대상이 필요할 때만 설정합니다.
# VITE_PROXY_TARGET=http://localhost:8080

# Kakao Maps JavaScript SDK 키입니다. Kakao Developers에 실행 도메인을 등록해야 합니다.
VITE_KAKAO_MAP_APP_KEY=your_kakao_javascript_key
